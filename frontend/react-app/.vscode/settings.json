{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.exclude": {
    "node_modules/": true,
    ".prettierignore": true,
    ".prettierrc": true,
    "eslint.config.js": true,
    "index.html": true,
    "package-lock.json": true,
  },
}